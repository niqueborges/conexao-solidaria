# syntax=docker/dockerfile:1
FROM python:3.11-slim

WORKDIR /workspace

# Instalar Node.js, dependências de build essenciais e Serverless Framework
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl gcc g++ make && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Copiar os arquivos base para dependências Node
COPY package.json package-lock.json ./

# Instalar pacotes de desenvolvimento local
RUN npm ci

CMD ["npx", "serverless", "offline", "--host", "0.0.0.0"]
